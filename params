namespace PaymentServices.RTPSend.Validators;

internal static class RoutingNumberValidator
{
    /// <summary>
    /// Normalizes a routing number to its canonical 9-digit form. An 8-digit
    /// value is treated as a 9-digit number whose leading zero was stripped
    /// upstream (numeric field, spreadsheet, integer parse), so it is left-padded.
    /// Returns null when the input can't be normalized.
    /// </summary>
    public static string? Normalize(string? routingNumber)
    {
        if (string.IsNullOrWhiteSpace(routingNumber))
            return null;

        var trimmed = routingNumber.Trim();

        if (trimmed.Length is < 8 or > 9)
            return null;

        foreach (var c in trimmed)
        {
            if (!char.IsDigit(c))
                return null;
        }

        return trimmed.Length == 8 ? "0" + trimmed : trimmed;
    }

    /// <summary>
    /// ABA routing transit number checksum, applied to the normalized 9-digit form:
    ///   3(d1+d4+d7) + 7(d2+d5+d8) + 1(d3+d6+d9) ≡ 0 (mod 10)
    /// Catches transposed and mistyped digits that a length check alone misses.
    /// </summary>
    public static bool HasValidChecksum(string? routingNumber)
    {
        var normalized = Normalize(routingNumber);
        if (normalized is null)
            return false;

        var d = new int[9];
        for (var i = 0; i < 9; i++)
            d[i] = normalized[i] - '0';

        var sum = 3 * (d[0] + d[3] + d[6])
                + 7 * (d[1] + d[4] + d[7])
                + 1 * (d[2] + d[5] + d[8]);

        return sum % 10 == 0;
    }
}






RuleFor(x => x.RoutingNumber)
    .Cascade(CascadeMode.Stop)
    .NotNull()
    .NotEmpty()
    .Matches(@"^\d{8,9}$")
    .WithMessage("Routing number must be 8 or 9 digits")
    .Must(RoutingNumberValidator.HasValidChecksum)
    .WithMessage("Routing number failed the ABA checksum");





