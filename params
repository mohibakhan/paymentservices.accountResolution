using FluentValidation;
using ReceivePaymentServicesFA.Models.Request;

namespace ReceivePaymentServicesFA.Validators;

public class TabaPayRequestValidator : AbstractValidator<TabaPayRequest>
{
    public TabaPayRequestValidator()
    {
        // Rule for instruction id
        RuleFor(x => x.InstructionId).Cascade(CascadeMode.Stop).NotNull().NotEmpty().WithMessage("Instruction Id is required");

        // Rule for original instruction id
        //RuleFor(x => x.RemittanceInformation.OriginalID).Cascade(CascadeMode.Stop).NotNull().NotEmpty().WithMessage("Remittance Original Id is required");

        // Rule for instructed amount — digits with at most 2 decimal places
        // (e.g. 1, 1.5, 1.50 pass; 1.5034, -1, 1.5E2, .5, 1,500 fail)
        RuleFor(x => x.InstructedAmount)
            .Cascade(CascadeMode.Stop)
            .NotNull()
            .NotEmpty()
            .MaximumLength(18)
            .Matches(@"^\d+(\.\d{1,2})?$")
            .WithMessage(x => $"{x.InstructedAmount} is not a valid amount. Amount must be a positive number with at most 2 decimal places")
            .Custom((x, context) =>
            {
                if (!decimal.TryParse(x, out decimal value) || value <= 0)
                {
                    context.AddFailure($"{x} is not a valid amount. Amount must be greater than 0");
                }
            });

        RuleFor(x => x.Debtor).NotNull().SetValidator(new CreditorDebtorValidator());

        RuleFor(x => x.Creditor).NotNull().SetValidator(new CreditorDebtorValidator());
    }
}
