namespace PaymentServices.RTPSend.Validators;

internal static class PhoneNumberValidator
{
    /// <summary>
    /// Strips common formatting and a leading US country code, returning the
    /// bare 10-digit NANP number. Returns null when the input can't be
    /// normalized to exactly 10 digits.
    /// </summary>
    public static string? Normalize(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return null;

        Span<char> digits = stackalloc char[16];
        var count = 0;

        foreach (var c in phone)
        {
            if (!char.IsDigit(c)) continue;
            if (count == digits.Length) return null;   // absurdly long — reject
            digits[count++] = c;
        }

        // Tolerate a leading US country code: 1 + 10 digits.
        if (count == 11 && digits[0] == '1')
            return new string(digits[1..11]);

        return count == 10 ? new string(digits[..10]) : null;
    }

    public static bool IsValid(string? phone) => Normalize(phone) is not null;
}
