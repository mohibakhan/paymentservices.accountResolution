// IPartnerLedgerCosmosDBAdapter
Task<PartnerLedgerResponse> GetItemByFboAccountAsync(string fboAccount);

// PartnerLedgerCosmosDBAdapter
public async Task<PartnerLedgerResponse> GetItemByFboAccountAsync(string fboAccount)
{
    var query = new QueryDefinition(
        "SELECT * FROM c WHERE c.fboAccount = @fboAccount")
        .WithParameter("@fboAccount", fboAccount);

    using var iterator = _container.GetItemQueryIterator<PartnerLedgerResponse>(query,
        requestOptions: new QueryRequestOptions { MaxItemCount = 1 });

    while (iterator.HasMoreResults)
    {
        var page = await iterator.ReadNextAsync();
        var item = page.FirstOrDefault();
        if (item != null) return item;
    }

    return null;
}
